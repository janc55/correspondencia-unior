# ─────────────────────────────────────────────────────────────
# UNIOR · Sistema de Correspondencia — variables de entorno
# Copiar a `.env` en la raíz y en `apps/api/.env` (o exportar).
# NUNCA versionar el archivo `.env` con secretos reales.
# ─────────────────────────────────────────────────────────────

# --- Base de datos (PostgreSQL) ---
# Usar el puerto 5433 para no chocar con una instalación local en 5432.
POSTGRES_USER=unior
POSTGRES_PASSWORD=unior_dev_password
POSTGRES_DB=correspondencia_unior
POSTGRES_PORT=5433
DATABASE_URL="postgresql://unior:unior_dev_password@localhost:5433/correspondencia_unior?schema=public"

# --- API ---
NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000
# Zona horaria institucional usada solo para presentación
INSTITUTION_TIMEZONE=America/La_Paz

# --- Seguridad ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-desarrollo"
JWT_ACCESS_TTL=3600
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo-y-aleatorio-de-desarrollo"
JWT_REFRESH_TTL=604800
# Secreto para firmar el código de verificación de la consulta pública (HMAC)
PUBLIC_VERIFICATION_SECRET="cambia-esto-por-un-tercer-secreto-aleatorio"
# Intentos por minuto permitidos en la consulta pública
PUBLIC_TRACKING_RATE_LIMIT=10

# --- Reglas de negocio ---
# Umbral de demora por tramo, en horas
OVERDUE_THRESHOLD_HOURS=24

# --- Archivos ---
# Directorio de almacenamiento local (fuera del directorio público)
STORAGE_DIR=./storage
MAX_ATTACHMENT_MB=10

# --- Correo (SMTP) ---
# Si SMTP_HOST está vacío, las notificaciones se registran como OMITIDAS en desarrollo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Correspondencia UNIOR <no-responder@unior.edu.bo>"
# Bandeja del equipo de seguimiento para alertas de demora
MAIL_TRACKING_TEAM="seguimiento@unior.edu.bo"
# Habilitar el envío programado de alertas de demora (cada hora)
OVERDUE_ALERTS_ENABLED=false

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_INSTITUTION_NAME="Universidad Privada de Oruro"
NEXT_PUBLIC_INSTITUTION_SHORT_NAME=UNIOR
